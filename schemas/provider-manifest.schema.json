{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TsekaLuk/specialist-os/main/schemas/provider-manifest.schema.json",
  "title": "Specialist Provider Manifest",
  "type": "object",
  "required": ["provider", "version", "runtime", "models", "metrics", "license", "platform"],
  "properties": {
    "provider": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "capability": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "runtime": {"type": "object"},
    "models": {"type": "object"},
    "metrics": {"type": "object"},
    "license": {"type": "object"},
    "platform": {"type": "object"},
    "network_required": {"type": "boolean"},
    "trust_level": {"enum": ["official", "verified", "community", "experimental"]}
  },
  "additionalProperties": true
  ,"anyOf": [{"required": ["capability"]}, {"required": ["capabilities"]}]
}
