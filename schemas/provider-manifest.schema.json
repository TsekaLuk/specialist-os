{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TsekaLuk/specialist-os/main/schemas/provider-manifest.schema.json",
  "title": "Specialist Provider Manifest",
  "type": "object",
  "required": ["provider", "version", "runtime", "models", "metrics", "license", "platform"],
  "properties": {
    "provider": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "capability": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "runtime": {"type": "object"},
    "models": {"type": "object"},
    "metrics": {"type": "object"},
    "license": {"type": "object"},
    "platform": {"type": "object"},
    "network_required": {"type": "boolean"},
    "trust_level": {"enum": ["official", "verified", "community", "experimental"]},
    "requirements": {
      "type": "array",
      "description": "Provider prerequisites as data. Requirements sharing a group are interchangeable sources of the same prerequisite and the group is satisfied when any member is. Endpoints are never contacted during a self-check.",
      "items": {
        "type": "object",
        "required": ["kind", "name"],
        "properties": {
          "kind": {"enum": ["binary", "env", "file", "endpoint"]},
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string"},
          "optional": {"type": "boolean", "default": false},
          "group": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
  ,"anyOf": [{"required": ["capability"]}, {"required": ["capabilities"]}]
}
