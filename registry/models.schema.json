{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specialist.runtime/schemas/models.schema.json",
  "title": "Specialist model registry",
  "type": "object",
  "required": ["schema_version", "code_license", "capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "code_license": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "command", "provider", "model", "modality", "description", "bundle", "models", "license", "source_url"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "modality": {"type": "string", "enum": ["image", "audio", "document"]},
          "description": {"type": "string", "minLength": 1},
          "input_schema": {"type": "object"},
          "output_schema": {"type": "object"},
          "bundle": {"type": "string", "minLength": 1},
          "optional_dependency": {"type": ["string", "null"]},
          "source_url": {"type": ["string", "null"], "pattern": "^https://"},
          "semantic_guarantees": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "quality_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "supports": {"type": "object", "additionalProperties": {"type": "boolean"}},
          "resource_profile": {"type": "object", "additionalProperties": true},
          "privacy_level": {"type": "string", "enum": ["safe", "sensitive", "restricted"]},
          "determinism": {"type": "string", "minLength": 1},
          "providers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "license": {"type": "object", "required": ["weights", "commercial"], "properties": {"weights": {"type": "string"}, "commercial": {"type": "boolean"}}},
          "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}}
        }
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": ["id", "recommended", "memory_mb", "disk_mb", "platforms", "devices", "artifact"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "recommended": {"type": "boolean"},
        "quality": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "memory_mb": {"type": "integer", "minimum": 0},
        "disk_mb": {"type": "integer", "minimum": 0},
        "platforms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "devices": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "artifact": {
          "type": "object",
          "required": ["url", "sha256"],
          "properties": {
            "url": {"type": ["string", "null"]},
            "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
        "kind": {"type": "string", "enum": ["file", "bundle", "server"]},
            "filename": {"type": ["string", "null"], "pattern": "^[^/\\\\]+$"},
            "entrypoint": {"type": ["string", "null"], "minLength": 1},
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "url", "sha256"],
                "properties": {
                  "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(?:/|$)).+$"},
                  "url": {"type": "string", "pattern": "^(https?|file)://"},
                  "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
                }
              }
            }
          }
        }
      }
    }
  }
}
